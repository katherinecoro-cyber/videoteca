# Copia este archivo como secrets.toml (no se sube a GitHub)
# o pega este contenido en "Settings → Secrets" de Streamlit Cloud.
ADMIN_PASSWORD = "cambia-esta-contraseña"

# Almacenamiento permanente (Supabase → Project Settings → API).
SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_KEY = "clave-service_role"
